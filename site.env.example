# Where and how this runs. Copy to site.env (git-ignored) and fill in.
# Every script sources it; nothing else in the repository names a host.
#
# The run used two NVIDIA DGX Spark-class nodes (GB10, 128 GB unified memory
# each) joined by a 200 Gb/s RoCE link, serving the model with vLLM at tensor
# parallel 2. See docs/reproducing.md.

# The head node: serves the model (vLLM rank 0, the API on :8001), builds every
# candidate on its GPU, runs the lab, and keeps all results under ~/abliterate.
HEAD_BOX=user@head-node
# The second node: vLLM rank 1. It only ever receives copies of builds.
WORK_BOX=user@second-node

# Lab working directory on the node that runs the lab (the head node here).
WORK_DIR='~/abliterate'
# The image builds and the lab run in. It needs PyTorch, safetensors and
# transformers >= 5.19 (for DeepseekV4Model); the vLLM serving image had all three.
BASE_IMAGE=vllm-node-b12x
IMAGE=vllm-node-b12x

# --- serving -----------------------------------------------------------------
# The pipeline switches what the cluster serves many times. It assumes, on
# HEAD_BOX:
#   $SERVE_DIR/models/<profile>.env   one file per serving profile (serving/profiles/)
#   $SERVE_DIR/active-model           the name of the profile to serve
#   a systemd --user unit $SERVE_UNIT that serves the profile active-model names,
#   across both nodes, on http://127.0.0.1:8001
# See serving/README.md for what the unit ran.
SERVE_DIR='~/vllm'
SERVE_UNIT=vllm-cluster
# Run locally to switch profiles (stop, point active-model, start, wait until the
# profile's SERVED_NAME answers). The reference implementation is in serving/.
SWITCH_MODEL=serving/switch-model.sh

# The fast link between the nodes, which builds (156 GiB each) are copied over.
# COPY_HOSTS: how HEAD_BOX reaches WORK_BOX on it (comma-separated, for rsync).
# HEAD_FAST_ADDR: how WORK_BOX reaches HEAD_BOX on it.
COPY_HOSTS=10.0.0.2
HEAD_FAST_ADDR=10.0.0.1
