# DeepSeek-V4-Flash-0731, stock: 284B total / 13B active, 155 GiB, 48 shards,
# FP8 with FP4 routed experts, the DSpark draft weights attached. Served across
# two GB10 nodes at tensor parallel 2 (no Ray), in a vLLM image with the B12X
# backends for GB10 (sm_121a). This is the profile the stock model, and so the
# judge, was served with; -exp and -uncensored source it and change only the
# weights directory and the served name.
#
# A profile is a set of variables a launcher turns into `vllm serve` on both
# nodes; serving/README.md has the exact command line this one produced.
# ${VAR:-default} throughout so an environment override still wins.

HF_REPO=deepseek-ai/DeepSeek-V4-Flash-0731
MODEL_DIR="${MODEL_DIR:-$HOME/models/deepseek-v4-flash-0731}"
MOUNT=/models/deepseek-v4-flash-0731
SERVED_NAME=deepseek-v4-flash-0731

IMAGE="${IMAGE:-vllm-node-b12x}"

# The checkpoint allows 1048576; 131072 is what was served.
MAX_MODEL_LEN="${MAX_MODEL_LEN:-131072}"

# GB10 memory is unified: at 0.85 the head node (which also ran other services)
# kept only ~5 GB available, so 0.82 (~11 GB available per node, KV cache ~220K
# tokens).
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.82}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"

# Speculative decoding from the checkpoint's own draft weights (DSpark).
SPEC_TOKENS="${SPEC_TOKENS:-5}"
SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":%d,"draft_sample_method":"probabilistic","attention_backend":"B12X"}'

CLUSTER_BACKEND=no-ray

# Container environment.
LAUNCHER_ARGS=(
  -e CUTE_DSL_ARCH=sm_121a
  -e VLLM_USE_AOT_COMPILE=1
  -e VLLM_USE_BREAKABLE_CUDAGRAPH=0
  -e VLLM_USE_MEGA_AOT_ARTIFACT=1
  -e VLLM_MEMORY_PROFILE_INCLUDE_ATTN=1
  -e VLLM_USE_FLASHINFER_SAMPLER=1
  -e VLLM_USE_B12X_WO_PROJECTION=1
  -e VLLM_USE_B12X_MHC=1
  -e VLLM_USE_B12X_FP8_GEMM=1
  -e VLLM_USE_B12X_MOE=1
  -e VLLM_USE_B12X_SPARSE_INDEXER=1
  -e VLLM_USE_V2_MODEL_RUNNER=1
  -e VLLM_MOE_SKIP_PADDING=0
  -e B12X_MLA_SM120_UNIFIED=1
  -e B12X_MOE_FORCE_A8=1
)

# reasoning_effort=medium: the model card names low, high and max; the server
# accepts medium and it behaves as low. Callers can raise it per request with
#   {"chat_template_kwargs": {"reasoning_effort": "high"}}
# Reasoning is switched per request with {"chat_template_kwargs": {"thinking": false}}.
MODEL_ARGS=(
  --trust-remote-code
  --kv-cache-dtype fp8
  --block-size 256
  --tokenizer-mode deepseek_v4
  --tool-call-parser deepseek_v4
  --reasoning-parser deepseek_v4
  --reasoning-config '{"reasoning_parser":"deepseek_v4","reasoning_start_str":"","reasoning_end_str":""}'
  --default-chat-template-kwargs.thinking=true
  --default-chat-template-kwargs.reasoning_effort=medium
  --load-format b12x
  --moe-backend b12x
  --linear-backend b12x
  --attention-backend B12X
  --max-cudagraph-capture-size 48
  --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}'
)
