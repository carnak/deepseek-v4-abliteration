# DeepSeek-V4-Flash-0731 abliterated: the refusal direction projected out of the
# residual-stream writers (attention wo_b, the shared and routed experts' w2) in
# layers 13-35 at weight 2.5, built by finalize.sh, which records in the
# checkpoint's ABLATION.txt exactly how it was made.
#
# Only the edited matrices are re-encoded, in DeepSeek's own FP8/FP4 formats;
# every other tensor, the config, the encoder and the DSpark draft weights are
# DeepSeek's, so it serves exactly as the stock build.
MODEL_DIR="${MODEL_DIR:-$HOME/models/deepseek-v4-flash-0731-uncensored}"

# shellcheck source=deepseek-v4-flash-0731.env
source "$(dirname "${BASH_SOURCE[0]}")/deepseek-v4-flash-0731.env"

HF_REPO=
MOUNT=/models/deepseek-v4-flash-0731-uncensored
SERVED_NAME=deepseek-v4-flash-0731-uncensored
