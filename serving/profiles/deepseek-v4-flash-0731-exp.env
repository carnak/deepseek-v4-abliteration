# The pipeline's scratch build of DeepSeek-V4-Flash-0731: every experiment
# overwrites ~/models/deepseek-v4-flash-0731-ablate-exp on both nodes and serves
# it under this profile. Same flags as the stock profile; only the weights
# directory and the served name differ.
MODEL_DIR="${MODEL_DIR:-$HOME/models/deepseek-v4-flash-0731-ablate-exp}"

# shellcheck source=deepseek-v4-flash-0731.env
source "$(dirname "${BASH_SOURCE[0]}")/deepseek-v4-flash-0731.env"

HF_REPO=
MOUNT=/models/deepseek-v4-flash-0731-ablate-exp
SERVED_NAME=deepseek-v4-flash-0731-exp
