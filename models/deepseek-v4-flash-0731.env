# Everything model-specific the pipeline needs, for DeepSeek-V4-Flash-0731 (284B
# total, 13B active; 43 layers, hyper-connections x4, 256 routed experts).
# Sourced on the head node by box/run_queue.sh and locally by abliterate.sh.
# These are the settings of the run that produced the kept build (2026-11-21);
# docs/results.md has what each rung scored.
#
# Three things set this model apart from a BF16 checkpoint on one machine:
#   1. There is no BF16 original. DeepSeek ships the weights in the precision
#      they were trained in (FP8 128x128 blocks; FP4 routed experts), so the
#      source of every edit is the checkpoint itself (BF16_NAME = STOCK_NAME),
#      decoded, edited, and re-encoded with direction-aware rounding
#      (tools/quant_formats.py dsv4_encode_steered; ablate.py checks survival).
#   2. It fills both nodes (TP=2). Every candidate is served across both, so
#      the build is copied to the other node before serving (TWO_BOX=1), and
#      there is no room left for a judge beside it (JUDGE_MODE=deferred).
#   3. Its template switches reasoning with `thinking`, not `enable_thinking`
#      (THINK_KWARG).

MODEL_KEY=deepseek-v4-flash-0731
ARCH=deepseek_v4

# Directories under ~/models on both nodes.
BF16_NAME=deepseek-v4-flash-0731            # = the stock build: native FP8/FP4, the only original there is
STOCK_NAME=deepseek-v4-flash-0731
SCRATCH_NAME=deepseek-v4-flash-0731-ablate-exp   # overwritten by every experiment (both nodes)
KEPT_NAME=deepseek-v4-flash-0731-uncensored
KEPT_PROFILE=deepseek-v4-flash-0731-uncensored

# Serving profile for the scratch checkpoint (serving/profiles/), and the id it serves.
EXP_PROFILE=deepseek-v4-flash-0731-exp
EXP_SERVED=deepseek-v4-flash-0731-exp

TWO_BOX=1
# A new checkpoint directory may compile its attention kernels afresh (the
# first start of this model took 756 s; warm starts take ~170-300 s).
SERVE_TIMEOUT=1500
THINK_KWARG=thinking

# The lab runs on the head node, in the serving image: it has transformers 5.19,
# whose DeepseekV4Model lab/stream_dsv4.py runs layer by layer.
LAB_BOX=head
LAB_IMAGE=vllm-node-b12x

# The judge is the unmodified model itself. It cannot run beside a candidate,
# so candidates only collect responses; box/judge_pending.sh judges them once
# the stock model is served again (docs/evaluation.md has its audit).
JUDGE_MODE=deferred
JUDGE_BASE=http://127.0.0.1:8001/v1
JUDGE_MODEL=deepseek-v4-flash-0731
JUDGE_MAX_TOKENS=8192
JUDGE_CONCURRENCY=8

# Prompt sets (under data/). The harmful ones are built by
# tools/build_prompt_sets.py; data/README.md.
HARMFUL_PROMPTS=prompts/tuning300.txt
QUICK_PROMPTS=prompts/tuning100.txt
HARMLESS_PROMPTS=harmless_test100.txt
STOCK_FIRST_TOKEN=kl/stock-deepseek-v4-flash-0731.json
EXP_ROOT=experiments

VALIDATION_HARMFUL=prompts/heldout300.txt
VALIDATION_BENIGN=jbb_benign100.txt
CAPABILITY_PROBLEMS=gsm8k_test200.jsonl
KNOWLEDGE_PROBLEMS=mmlu_test500.jsonl

ROBUST_PROMPTS=prompts/heldout100.txt
ROBUST_BENIGN=prompts/benign50.txt
ROBUST_SCENARIOS="system-cautious multi-turn long-context tools"

# Response budgets. Thinking off: 400 tokens. Thinking on: the server's
# reasoning effort is "medium" (behaves as low), and stock reasoning on a plain
# question is a few hundred characters; 8192 leaves an abliterated build room
# to reason and answer (an unfinished response is recorded, never judged).
NOTHINK_TOKENS=400
THINKING_TOKENS=8192
FINISH_TOKENS=0
QUICK_THINKING_TOKENS=8192
QUICK_FINISH_TOKENS=0

# --- abliterate.sh -------------------------------------------------------------
DIRECTION=deepseek-v4-nothink
# Edit layers. geometry.py suggested 20-42 (separation jumps at 20, peaks at 41),
# but editing layers 36-42 is what breaks the model: served mean2.0 over 20-42
# drifted first-token KL 2.4 and looped; in the lab (lab.cli dsv4-screen, exact,
# no re-encoding) mean2.0 over 20-42 drifts 2.58 and over 20-35 0.10, with every
# harmful prompt's first word changed. So the band stops at 35.
LADDER_LAYERS=20-35
# The 4 hyper-connection copies carry different refusal directions (cosine with
# the mean's 0.29-0.98 across the band; docs/method.md). The lab screen showed
# removing the span of the four copies' directions drifts more than the mean's
# one direction for the same effect, so every rung uses the mean direction.
HC_DISAGREE_OK=1
# The screen: an unedited control, then these. A rung's --layers overrides
# LADDER_LAYERS (ablate.py takes the last one given).
# The first screen (layers 20-42: mean2.0, mean2.5) is in docs/results.md; both
# drifted KL 2.4-4.0. The first four rungs here were judged first, rising with
# both strength and an earlier start, so the last two push each. m2.5-13-35 won.
LADDER="m1.5-20-35 | --weight 1.5
m2.0-20-35 | --weight 2.0
m1.5-13-35 | --layers 13-35 --weight 1.5
m2.0-13-35 | --layers 13-35 --weight 2.0
m2.5-13-35 | --layers 13-35 --weight 2.5
m2.0-8-35 | --layers 8-35 --weight 2.0"
# Screen on the 100-prompt tuning set: each response is judged by the stock
# model afterwards, so judging time is what QUICK saves.
SCREEN_QUICK=1
SELECT_TOLERANCE=3
FINALISTS=2
MMLU_DROP=5
MIN_BENIGN=95
MAX_UNFINISHED=2
# DSpark (the draft head) reads the edited hidden states; a candidate that
# decodes much slower than the control is not kept.
MIN_SPEED=0.9
